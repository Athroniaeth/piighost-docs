{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pagefind --site build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"content:check": "tsx scripts/check-content.ts",
		"graph": "sh scripts/graph.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@mermaid-js/mermaid-cli": "^12.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22",
		"@types/unist": "^3.0.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"github-slugger": "^2.0.0",
		"globals": "^17.6.0",
		"hast-util-from-html-isomorphic": "^2.0.0",
		"hast-util-to-string": "^3.0.1",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-to-string": "^4.0.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"property-information": "^7.2.0",
		"puppeteer-core": "^25.12.0",
		"rehype-raw": "^7.0.0",
		"remark-directive": "^4.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.5.0",
		"smol-toml": "^1.9.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.3.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.49.0",
		"@openpanel/web": "^1.4.1",
		"@piighost/ui": "file:vendor/piighost-ui-0.2.2.tgz"
	}
}
